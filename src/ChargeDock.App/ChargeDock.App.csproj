<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>ChargeDock.App</RootNamespace>
    <AssemblyName>ChargeDock</AssemblyName>
    <LangVersion>latest</LangVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ChargeDock.Core\ChargeDock.Core.csproj" />
    <ProjectReference Include="..\ChargeDock.Devices\ChargeDock.Devices.csproj" />
  </ItemGroup>

</Project>
