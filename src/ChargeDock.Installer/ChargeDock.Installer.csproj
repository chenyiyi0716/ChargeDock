<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>ChargeDock-Setup</AssemblyName>
    <RootNamespace>ChargeDock.Installer</RootNamespace>
    <LangVersion>latest</LangVersion>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
  </PropertyGroup>

  <ItemGroup>
    <!-- 发布脚本会把自包含主程序复制到 payload/,再把它内嵌进安装包 -->
    <EmbeddedResource Include="payload\ChargeDock.exe" LogicalName="ChargeDock.exe"
                      Condition="Exists('payload\ChargeDock.exe')" />
  </ItemGroup>

</Project>
